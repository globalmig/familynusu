{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "familynusu",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 아래 두 바인딩은 실제 리소스를 만든 뒤 id/bucket_name을 채워주세요.
  // 1) wrangler kv namespace create familynusu-cases  -> 나온 id를 kv_namespaces[0].id에 넣기
  // 2) wrangler r2 bucket create familynusu-cases      -> bucket_name은 그대로 사용
  "kv_namespaces": [
    {
      "binding": "CASES_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CASES_BUCKET",
      "bucket_name": "familynusu-cases"
    }
  ]
}
